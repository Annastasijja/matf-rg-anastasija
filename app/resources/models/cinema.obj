# Home cinema room
# Y = up

mtllib cinema.mtl

o cinema

# Vrhovi poda
v -6.0 0.0 -6.0
v  6.0 0.0 -6.0
v  6.0 0.0  6.0
v -6.0 0.0  6.0

# Vrhovi zadnjeg zida
v -6.0 0.0 -6.0
v  6.0 0.0 -6.0
v  6.0 4.0 -6.0
v -6.0 4.0 -6.0

# Vrhovi levog zida
v -6.0 0.0 -6.0
v -6.0 0.0  6.0
v -6.0 4.0  6.0
v -6.0 4.0 -6.0

# Vrhovi desnog zida
v  6.0 0.0  6.0
v  6.0 0.0 -6.0
v  6.0 4.0 -6.0
v  6.0 4.0  6.0

# Normale
vn 0.0 1.0 0.0
vn 0.0 0.0 1.0
vn 1.0 0.0 0.0
vn -1.0 0.0 0.0

# UV koordinate za pod
vt 0.0 0.0
vt 4.0 0.0
vt 4.0 4.0
vt 0.0 4.0

# Pod
usemtl floor
f 1/1/1 3/3/1 2/2/1
f 1/1/1 4/4/1 3/3/1

# Zidovi
usemtl wall

# Zadnji zid
f 5//2 6//2 7//2
f 5//2 7//2 8//2

# Levi zid
f 9//3 10//3 11//3
f 9//3 11//3 12//3

# Desni zid
f 13//4 14//4 15//4
f 13//4 15//4 16//4